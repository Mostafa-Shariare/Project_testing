ENVIRONMENT=development
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_HOURS=24

MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=attention_tracker

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000

REQUIRE_JOIN_CODE=false
SESSION_LOG_INTERVAL_SEC=5
STUDENT_STALE_SEC=8
HISTORY_LIMIT=50
SESSION_TTL_DAYS=90

AUTH_RATE_LIMIT=20
AUTH_RATE_WINDOW_SEC=60
TELEMETRY_RATE_LIMIT=120
TELEMETRY_RATE_WINDOW_SEC=60
